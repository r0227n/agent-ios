{
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "mcp__deepwiki__ask_question",
      "Bash(idb:*)",
      "Bash(cargo build:*)",
      "Bash(cargo clean:*)",
      "Bash(cargo test:*)",
      "Bash(./target/debug/agent-mobile:*)"
    ],
    "deny": [],
    "defaultMode": "plan"
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "ENABLE_EXPERIMENTAL_MCP_CLI": "false"
  },
  "language": "japanese",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cargo fmt --all",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
  }
}
